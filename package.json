{
  "name": "thepit",
  "version": "0.1.0",
  "private": true,
  "description": "Static, offline casino of play-money table games. The games themselves have no dependencies; Puppeteer is only for the optional browser tests.",
  "author": "abel0x",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://abel0x.github.io/thepit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abel0x/thepit.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\" \"tests/**/*.test.cjs\"",
    "test:browser": "node --test \"tests/browser/*.spec.cjs\"",
    "serve": "python3 -m http.server 8000 --bind 127.0.0.1"
  },
  "devDependencies": {
    "puppeteer": "25.13.0"
  },
  "allowScripts": {
    "puppeteer@25.13.0": true
  }
}
